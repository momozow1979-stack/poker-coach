# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# CFR solver (solver/) — Python tooling, independent of the Flutter app
solver/.venv/
solver/**/__pycache__/
solver/**/*.egg-info/
solver/solved_spots.json

# CFRSolver.save()/.load() training checkpoints — multi-GB binary blobs that
# belong on disk (this repo's persistent-enough filesystem), never in git.
# See BENCHMARKS.md's full-hand-range resume section for what's stored here.
/.solver-checkpoints/

# Rust native extension build output (solver/native/) — Cargo build
# artifacts, never committed.
solver/native/target/

# maturin's editable/develop build drops the compiled extension module
# straight into the package directory — never committed either.
solver/cfr_solver/_native*.so
solver/cfr_solver/_native*.pyd

# External solvers cloned locally for cross-validation only (e.g. TexasSolver,
# AGPL-licensed) — never vendored into this repo, and never distributed.
solver/vendor/

# External solvers cloned locally for cross-validation only (e.g. TexasSolver,
# AGPL-licensed) — never vendored into this repo, and never distributed.
solver/vendor/

